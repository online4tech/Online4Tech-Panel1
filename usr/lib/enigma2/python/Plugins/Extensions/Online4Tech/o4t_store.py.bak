    def __init__(self, session):
        Screen.__init__(self, session)
        self.session = session
        loaded_fonts = ensure_fonts_loaded()
        self.ui_font = "O4TArabic" if "O4TArabic" in loaded_fonts else ("O4TRegular" if "O4TRegular" in loaded_fonts else "Regular")

        self.db_data = {}
        self.main_sections = []
        self.current_cat_idx = 0
        self.current_section_key = ""
        self.current_section_title = ""
        self.current_items = []
        self.focus_pane = "items"  # "cats" or "items"
        self.nav_stack = []

        img_name, py_ver, ip, clock_str, date_str = get_device_info()

        self["brand_logo"] = Pixmap()
        self["brand_sub"] = Label("متجر Online4Tech • دعم: %s" % SUPPORT_PHONE)
        self["top_title"] = Label("متجر Online4Tech الرسمي")
        self["top_subtitle"] = Label("جاري تحميل قاعدة البيانات...")
        self["dev_info_top"] = Label("%s  |  Py %s  |  IP: %s" % (img_name, py_ver, ip))
        self["dev_info_bot"] = Label("%s  •  %s  •  %s" % (clock_str, date_str, STORE_URL))

        self["cats_header"] = Label("أقسام المتجر")
        self["cat_list"] = Online4TechMenuList([], font_name=self.ui_font, font_size=24)

        self["items_header"] = Label("العناصر والحزم")
        self["page_info"] = Label("0 عنصر")
        self["item_list"] = Online4TechMenuList([], font_name=self.ui_font, font_size=24)

        self["preview_icon"] = Pixmap()
        self["detail_title"] = Label("Online4Tech v7.5 Gold")
        self["detail_status"] = Label("جاهز للاستعراض")
        self["detail_desc"] = Label("اختر قسماً أو حزمة من القائمة لعرض التفاصيل الكاملة وتنفيذ التثبيت أو الحذف.")
        self["action_cta"] = Label("تثبيت / فتح  •  OK")
        self["action_sub"] = Label("الأخضر: تنفيذ  |  الأصفر: حذف  |  الأزرق: تحديث")

        self["key_red"] = Label("رجوع / إغلاق")
        self["key_green"] = Label("تثبيت / فتح")
        self["key_yellow"] = Label("حذف / إزالة")
        self["key_blue"] = Label("تحديث المصدر")
        self["footer_hint"] = Label("يمين/يسار: تبديل العمود  |  OK: اختيار  |  EXIT: رجوع")

        self["actions"] = ActionMap(
            ["OkCancelActions", "ColorActions", "DirectionActions"],
            {
                "ok": self.ok_pressed,
                "cancel": self.back_pressed,
                "red": self.back_pressed,
                "green": self.ok_pressed,
                "yellow": self.remove_pressed,
                "blue": self.refresh_db,
                "up": self.move_up,
                "down": self.move_down,
                "left": self.focus_items_pane,
                "right": self.focus_cats_pane,
            },
            -1,
        )

        self.onLayoutFinish.append(self.init_screen)

    def init_screen(self):
        brand_img = find_icon("logo.png") or find_icon("plugin.png")
        if brand_img and self["brand_logo"].instance:
            self["brand_logo"].instance.setPixmapFromFile(brand_img)
        self.load_database(force=False)

    def load_database(self, force=False):
        try:
            if force or not os.path.exists(CACHE_DB) or os.path.getsize(CACHE_DB) == 0:
                self["top_subtitle"].setText("جاري الاتصال بسيرفر Online4Tech...")
                req = Request(DB_URL, headers={"User-Agent": "Online4Tech-Enigma2-v7.5"})
                resp = urlopen(req, timeout=20)
                raw = resp.read().decode("utf-8", errors="ignore")
                with io.open(CACHE_DB, "w", encoding="utf-8") as f:
                    f.write(raw)

            with io.open(CACHE_DB, "r", encoding="utf-8", errors="ignore") as f:
                self.db_data = json.load(f)

            self.main_sections = self.db_data.get("main", [])
            self.nav_stack = []
            self.populate_categories()
            if self.main_sections:
                first_sec = self.main_sections[0]
                self.open_section(
                    first_sec.get("section", ""),
                    clean_text(first_sec.get("title", first_sec.get("section", ""))),
                    icon_name=first_sec.get("icon", ""),
                    push_history=False,
                )
            self["top_subtitle"].setText("تم تحميل %d قسم رئيسي بنجاح" % len(self.main_sections))
        except Exception as e:
            self["top_subtitle"].setText("تعذر الاتصال بالسيرفر أو قراءة قاعدة البيانات")
            self["detail_desc"].setText("تفاصيل الخطأ:\n%s" % clean_text(str(e)))

    def refresh_db(self):
        self.load_database(force=True)

    def populate_categories(self):
        entries = []
        for sec in self.main_sections:
            sec_key = sec.get("section", "")
            title = clean_text(sec.get("title", sec_key))
            sec_items = self.db_data.get(sec_key, [])
            count_str = "%d عنصر" % len(sec_items) if isinstance(sec_items, list) else ""
            entries.append(build_category_entry(title, count_str, False, self.ui_font, 24))
        self["cat_list"].setList(entries)
        if entries:
            self["cat_list"].moveToIndex(min(self.current_cat_idx, len(entries) - 1))

    def open_section(self, section_key, title, icon_name="", push_history=True):
        if push_history and self.current_section_key:
            self.nav_stack.append((
                self.current_section_key,
                self.current_section_title,
                list(self.current_items),
                self["item_list"].getSelectedIndex() or 0,
            ))

        self.current_section_key = section_key
        self.current_section_title = title
        raw_items = self.db_data.get(section_key, [])
        self.current_items = raw_items if isinstance(raw_items, list) else []

        self["top_title"].setText(title or "Online4Tech Store")
        self["items_header"].setText(title or "العناصر")
        self["page_info"].setText("%d عنصر" % len(self.current_items))

        list_entries = []
        for it in self.current_items:
            if "section" in it:
                sub_title = clean_text(it.get("title", it.get("section", "")))
                sub_key = it.get("section", "")
                sub_count = len(self.db_data.get(sub_key, []))
                list_entries.append(build_item_entry(sub_title, "قسم فرعي • %d عنصر" % sub_count, False, self.ui_font, 24))
            else:
                name = clean_text(it.get("name", "بدون اسم"))
                path = it.get("path", "")
                installed = bool(path and os.path.exists(path))
                sub_txt = "المسار: %s" % path if path else "حزمة / سكريبت Online4Tech"
                list_entries.append(build_item_entry(name, sub_txt, installed, self.ui_font, 24))

        self["item_list"].setList(list_entries)
        if list_entries:
            self["item_list"].moveToIndex(0)
        self.update_preview(icon_override=icon_name)

    def update_preview(self, icon_override=""):
        idx = self["item_list"].getSelectedIndex()
        if idx is None or idx < 0 or idx >= len(self.current_items):
            self["detail_title"].setText(self.current_section_title or "Online4Tech")
            self["detail_status"].setText("لا توجد عناصر في هذا القسم")
            self["detail_desc"].setText("اختر قسماً آخر من العمود الأيمن أو اضغط تحديث المصدر.")
            return

        item = self.current_items[idx]
        if "section" in item:
            title = clean_text(item.get("title", item.get("section", "")))
            sub_key = item.get("section", "")
            cnt = len(self.db_data.get(sub_key, []))
            self["detail_title"].setText(title)
            self["detail_status"].setText("قسم فرعي (%d عنصر)" % cnt)
            self["detail_desc"].setText("اضغط OK أو الزر الأخضر لفتح هذا القسم واستعراض الحزم بداخله.")
            self["action_cta"].setText("فتح القسم  •  OK")
            self["action_sub"].setText("استعراض %d عنصر" % cnt)
            icon_file = find_icon(item.get("icon", "") or icon_override)
        else:
            name = clean_text(item.get("name", "حزمة"))
            path = item.get("path", "")
            cmd = item.get("cmd", "")
            installed = bool(path and os.path.exists(path))
            self["detail_title"].setText(name)
            self["detail_status"].setText("✓ مثبت على الجهاز" if installed else "غير مثبت حالياً")
            desc_lines = []
            if path:
                desc_lines.append("المسار: %s" % path)
            if cmd:
                desc_lines.append("الأمر: %s" % cmd[:140])
            if item.get("remove_cmd"):
                desc_lines.append("يدعم الإزالة المباشرة بالزر الأصفر.")
            self["detail_desc"].setText("\n".join(desc_lines) if desc_lines else "حزمة جاهزة للتثبيت عبر Online4Tech.")
            self["action_cta"].setText("إعادة تثبيت / فتح  •  OK" if installed else "تثبيت الآن  •  OK")
            self["action_sub"].setText("الأخضر: تثبيت  |  الأصفر: إزالة  |  EXIT: رجوع")
            icon_file = find_icon(item.get("icon", "") or icon_override)

        if icon_file and self["preview_icon"].instance:
            self["preview_icon"].instance.setPixmapFromFile(icon_file)

    def move_up(self):
        if self.focus_pane == "cats":
            self["cat_list"].up()
            idx = self["cat_list"].getSelectedIndex()
            if idx is not None and 0 <= idx < len(self.main_sections):
                self.current_cat_idx = idx
                sec = self.main_sections[idx]
                self.open_section(
                    sec.get("section", ""),
                    clean_text(sec.get("title", sec.get("section", ""))),
                    icon_name=sec.get("icon", ""),
                    push_history=False,
                )
        else:
            self["item_list"].up()
            self.update_preview()

    def move_down(self):
        if self.focus_pane == "cats":
            self["cat_list"].down()
            idx = self["cat_list"].getSelectedIndex()
            if idx is not None and 0 <= idx < len(self.main_sections):
                self.current_cat_idx = idx
                sec = self.main_sections[idx]
                self.open_section(
                    sec.get("section", ""),
                    clean_text(sec.get("title", sec.get("section", ""))),
                    icon_name=sec.get("icon", ""),
                    push_history=False,
                )
        else:
            self["item_list"].down()
            self.update_preview()

    def focus_cats_pane(self):
        self.focus_pane = "cats"
        self["footer_hint"].setText("التركيز: الأقسام  |  OK: فتح  |  يسار: العناصر  |  EXIT: رجوع")

    def focus_items_pane(self):
        self.focus_pane = "items"
        self["footer_hint"].setText("التركيز: العناصر  |  OK: تثبيت  |  يمين: الأقسام  |  EXIT: رجوع")

    def ok_pressed(self):
        if self.focus_pane == "cats":
            idx = self["cat_list"].getSelectedIndex()
            if idx is not None and 0 <= idx < len(self.main_sections):
                self.current_cat_idx = idx
                sec = self.main_sections[idx]
                self.open_section(
                    sec.get("section", ""),
                    clean_text(sec.get("title", sec.get("section", ""))),
                    icon_name=sec.get("icon", ""),
                    push_history=True,
                )
                self.focus_items_pane()
            return

        idx = self["item_list"].getSelectedIndex()
        if idx is None or idx < 0 or idx >= len(self.current_items):
            return
        item = self.current_items[idx]
        if "section" in item:
            self.open_section(
                item.get("section", ""),
                clean_text(item.get("title", item.get("section", ""))),
                icon_name=item.get("icon", ""),
                push_history=True,
            )
        else:
            cmd = item.get("cmd", "")
            name = clean_text(item.get("name", "Package"))
            if cmd:
                self.session.open(Console, title="Online4Tech - %s" % name, cmdlist=[cmd], closeOnSuccess=False)

    def remove_pressed(self):
        idx = self["item_list"].getSelectedIndex()
        if idx is None or idx < 0 or idx >= len(self.current_items):
            return
        item = self.current_items[idx]
        rem_cmd = item.get("remove_cmd", "")
        name = clean_text(item.get("name", "Package"))
        if rem_cmd:
            self.session.open(Console, title="Online4Tech Remove - %s" % name, cmdlist=[rem_cmd], closeOnSuccess=False)
        else:
            self.session.open(MessageBox, "لا يوجد أمر حذف تلقائي متاح لهذا العنصر.", MessageBox.TYPE_INFO, timeout=3)

    def back_pressed(self):
        if self.nav_stack:
            prev_key, prev_title, prev_items, prev_idx = self.nav_stack.pop()
            self.current_section_key = prev_key
            self.current_section_title = prev_title
            self.current_items = prev_items
            self["top_title"].setText(prev_title or "Online4Tech Store")
            self["items_header"].setText(prev_title or "العناصر")
            self["page_info"].setText("%d عنصر" % len(prev_items))

            entries = []
            for it in prev_items:
                if "section" in it:
                    sub_t = clean_text(it.get("title", it.get("section", "")))
                    cnt = len(self.db_data.get(it.get("section", ""), []))
                    entries.append(build_item_entry(sub_t, "قسم فرعي • %d عنصر" % cnt, False, self.ui_font, 24))
                else:
                    nm = clean_text(it.get("name", "بدون اسم"))
                    pth = it.get("path", "")
                    inst = bool(pth and os.path.exists(pth))
                    entries.append(build_item_entry(nm, "المسار: %s" % pth if pth else "حزمة Online4Tech", inst, self.ui_font, 24))

            self["item_list"].setList(entries)
            if entries:
                self["item_list"].moveToIndex(min(prev_idx, len(entries) - 1))
            self.update_preview()
        else:
            self.close()