PLUGIN_DIR = "/usr/lib/enigma2/python/Plugins/Extensions/Online4Tech"
FONTS_DIR = os.path.join(PLUGIN_DIR, "fonts")
ICONS_DIR = os.path.join(PLUGIN_DIR, "icons")
DB_URL = "https://raw.githubusercontent.com/online4tech/Online4Tech-Panel1/main/o4t_database.json"
CACHE_DB = "/tmp/o4t_database.json"

STORE_URL = "https://sllr.co/online4tech"
SUPPORT_PHONE = "01006699169"


def ensure_fonts_loaded():
    loaded = set()
    candidates = [
        ("O4TArabic", ["Cairo-Bold.ttf", "Cairo-Regular.ttf", "Amiri-Bold.ttf", "Amiri-Regular.ttf"]),
        ("O4TRegular", ["Cairo-Regular.ttf", "Amiri-Regular.ttf", "Cairo-Bold.ttf"]),
    ]
    if not os.path.isdir(FONTS_DIR):
        return loaded
    for alias, files in candidates:
        for fname in files:
            fpath = os.path.join(FONTS_DIR, fname)
            if os.path.isfile(fpath) and os.path.getsize(fpath) > 0:
                try:
                    addFont(fpath, alias, 100, False)
                    loaded.add(alias)
                    break
                except Exception:
                    pass
    return loaded


def clean_text(txt):
    if not txt:
        return ""
    if not isinstance(txt, type(u"")):
        try:
            txt = txt.decode("utf-8", "ignore")
        except Exception:
            txt = str(txt)
    txt = re.sub(r'\(\s*\)', '', txt)
    txt = re.sub(r'\s+', ' ', txt).strip()
    return txt


def get_device_info():
    py_ver = "%d.%d" % (sys.version_info[0], sys.version_info[1])
    ip = "Offline"
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(1.5)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
    except Exception:
        pass

    image_name = "Enigma2"
    for p in ["/etc/issue", "/etc/version"]:
        if os.path.isfile(p):
            try:
                with io.open(p, "r", encoding="utf-8", errors="ignore") as f:
                    line = f.read().strip().splitlines()
                    if line:
                        image_name = line[0].strip()[:24]
                        break
            except Exception:
                pass

    now = datetime.now()
    clock_str = now.strftime("%I:%M %p").lstrip("0")
    date_str = now.strftime("%Y-%m-%d")
    return image_name, py_ver, ip, clock_str, date_str


def find_icon(icon_name):
    if not icon_name:
        return None
    candidates = [
        os.path.join(ICONS_DIR, icon_name),
        os.path.join(PLUGIN_DIR, icon_name),
        os.path.join(PLUGIN_DIR, "logo.png"),
        os.path.join(PLUGIN_DIR, "plugin.png"),
    ]
    for path in candidates:
        if os.path.isfile(path) and os.path.getsize(path) > 0:
            return path
    return None


class Online4TechMenuList(MenuList):
    def __init__(self, list_items, font_name="Regular", font_size=24):
        MenuList.__init__(self, list_items, enableWrapAround=True, content=eListboxPythonMultiContent)
        self.l.setFont(0, gFont(font_name, font_size))
        self.l.setFont(1, gFont(font_name, max(18, font_size - 4)))
        self.l.setItemHeight(64)


def build_category_entry(title, count_text="", installed=False, font_name="Regular", font_size=24):
    res = [(title, count_text, installed)]
    res.append((eListboxPythonMultiContent.TYPE_TEXT, 18, 8, 360, 32, 0, RT_HALIGN_RIGHT | RT_VALIGN_CENTER, title))
    if count_text:
        res.append((eListboxPythonMultiContent.TYPE_TEXT, 18, 38, 360, 22, 1, RT_HALIGN_RIGHT | RT_VALIGN_CENTER, count_text))
    if installed:
        res.append((eListboxPythonMultiContent.TYPE_TEXT, 385, 16, 45, 32, 0, RT_HALIGN_LEFT | RT_VALIGN_CENTER, "✓"))
    return res


def build_item_entry(name, sub_info="", installed=False, font_name="Regular", font_size=24):
    res = [(name, sub_info, installed)]
    status_badge = "✓ مثبت" if installed else ""
    if status_badge:
        res.append((eListboxPythonMultiContent.TYPE_TEXT, 16, 10, 120, 44, 1, RT_HALIGN_LEFT | RT_VALIGN_CENTER, status_badge))
        res.append((eListboxPythonMultiContent.TYPE_TEXT, 145, 6, 560, 32, 0, RT_HALIGN_RIGHT | RT_VALIGN_CENTER, name))
    else:
        res.append((eListboxPythonMultiContent.TYPE_TEXT, 16, 6, 689, 32, 0, RT_HALIGN_RIGHT | RT_VALIGN_CENTER, name))
    if sub_info:
        res.append((eListboxPythonMultiContent.TYPE_TEXT, 16, 36, 689, 22, 1, RT_HALIGN_RIGHT | RT_VALIGN_CENTER, sub_info))
    return res


